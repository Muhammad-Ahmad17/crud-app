@model ClinicMvc.Models.Patient
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3 class="text-danger">Are you sure you want to delete this patient?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DateOfBirth)</dt>
    <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
    <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
